{
  "expo": {
    "name": "Aiventre",
    "slug": "aiventre",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aiventre",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.aiventre.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.aiventre.app",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#247b50"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aiventre opens your photos so you can pick a drawing to quote.",
          "cameraPermission": "Aiventre uses the camera so you can photograph a drawing to quote.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aiventre uses your location once, to fill in where your shop is so the AI finds buyers nearby.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/app"
    },
    "backgroundColor": "#111111",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bec2b2e6-a6b9-431d-b8ba-3ed7dacae408"
      }
    },
    "owner": "alvinleopeter"
  }
}
