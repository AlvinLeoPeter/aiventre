# Copy to `.env` and fill in. Empty values are hidden on the site, never faked.

# Where the "Get early access" form posts (e.g. https://formspree.io/f/xxxxxxx).
# Leave empty to fall back to opening the visitor's email app.
VITE_FORM_ENDPOINT=

VITE_CONTACT_EMAIL=hello@aiventre.com

# Shown as "Call us" when set, e.g. +91 98xxx xxxxx
VITE_CONTACT_PHONE=

# Enables "Chat on WhatsApp" when set. Digits with country code, e.g. 9198xxxxxxxx
VITE_WHATSAPP_NUMBER=
