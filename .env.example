# Copy to `.env` for local development, and set the same variables in Vercel
# (Project → Settings → Environment Variables) for production.

# ---- App / AI agent (server-side only; never exposed to the browser) ----
# Your Anthropic API key, from console.anthropic.com
ANTHROPIC_API_KEY=
# Code pilot users type to open /app. Anyone with it can use your API credits,
# so pick something hard to guess and share it only with pilot shops.
APP_ACCESS_CODE=
# Signed-in app users (Supabase login) can use the AI instead of the code, but only
# these emails, comma-separated — so a stranger who signs up can't spend credits.
SUPABASE_URL=
APP_ALLOWED_EMAILS=
# Optional: which Claude model does which job. ANTHROPIC_MODEL sets them all.
# Buyer and supplier research, the assistant (default claude-opus-5-5)
ANTHROPIC_MODEL_AGENT=
# Reading drawings for quotes (default claude-opus-5-5)
ANTHROPIC_MODEL_QUOTE=
# Machine expert chat (default claude-opus-5-5)
ANTHROPIC_MODEL_EXPERT=
# Profile, emails, reply sorting (default claude-sonnet-5-5)
ANTHROPIC_MODEL_SIMPLE=
ANTHROPIC_MODEL=

# ---- Marketing site (public, shown on the page) ----
# Where the "Join the pilot" form posts (e.g. https://formspree.io/f/xxxxxxx).
# Leave empty to fall back to opening the visitor's email app.
VITE_FORM_ENDPOINT=
VITE_CONTACT_EMAIL=hello@aiventre.com
# Shown as "Call us" when set, e.g. +91 98xxx xxxxx
VITE_CONTACT_PHONE=
# Enables "Chat on WhatsApp" when set. Digits with country code, e.g. 9198xxxxxxxx
VITE_WHATSAPP_NUMBER=
