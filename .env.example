# Copy to `.env` for local development, and set the same variables in Vercel
# (Project → Settings → Environment Variables) for production.

# ---- App / AI agent (server-side only; never exposed to the browser) ----
# Your Anthropic API key, from console.anthropic.com
ANTHROPIC_API_KEY=
# Code pilot users type to open /app. Anyone with it can use your API credits,
# so pick something hard to guess and share it only with pilot shops.
APP_ACCESS_CODE=
# Optional: override the model (default claude-opus-5)
ANTHROPIC_MODEL=

# ---- Marketing site (public, shown on the page) ----
# Where the "Join the pilot" form posts (e.g. https://formspree.io/f/xxxxxxx).
# Leave empty to fall back to opening the visitor's email app.
VITE_FORM_ENDPOINT=
VITE_CONTACT_EMAIL=hello@aiventre.com
# Shown as "Call us" when set, e.g. +91 98xxx xxxxx
VITE_CONTACT_PHONE=
# Enables "Chat on WhatsApp" when set. Digits with country code, e.g. 9198xxxxxxxx
VITE_WHATSAPP_NUMBER=
